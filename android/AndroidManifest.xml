<?xml version="1.0" encoding="utf-8"?>
<!--
  RetroBug — RetroBug contributors. SPDX-License-Identifier: Apache-2.0

  The host-side launcher's manifest: the smallest thing that installs and launches as a real third-party
  app, same posture as `tests/appdomain/AndroidManifest.xml`.

  Deliberately absent, and each absence is a decision rather than an omission:

    - Two permissions only: REQUEST_INSTALL_PACKAGES, which "Make installable" needs to hand a repackaged
      game to PackageInstaller, and REQUEST_DELETE_PACKAGES, for the library's "Remove the playable copy"
      (Android's own uninstall prompt). It is an app-op the user grants in "Install unknown apps", not a runtime
      grant, and changes nothing about the process's SELinux domain or seccomp state. Every other
      permission stays out: each is a reason the process could be in a different domain than the app
      RetroBug eventually ships, and the answers this launcher exists to produce are about that domain.
    - No `android:extractNativeLibs`. `tools/build_launcher_apk.sh` adds `lib/` with plain `jar`, which
      deflates it, so the platform has to extract `librguest.so` before `System.loadLibrary` can find it
      — the same shape the app-domain probe installs in and is recorded as working on both devices.
    - No `uses-native-library` or ABI restriction. The APK carries exactly one ABI directory (`arm64-v8a`),
      so the package manager has no choice to make: RetroBug is the host, and the guest's `armeabi-v7a`
      bytes are data inside an asset, never a library this process asks the system to load.

  One thing that is *not* absent: the launcher icon, added on the owner's instruction and generated by
  `tools/make_launcher_icon.ps1` from `file_0000000033448211bbdb620eed523634.png`. That source is the
  Android robot, which is Google's and is used under the terms of the Creative Commons 3.0 Attribution
  licence; the attribution lives in `NOTICE.md` because the licence requires it, not as a courtesy. It is
  the platform's mascot rather than a mark of this project, so it says nothing about who wrote RetroBug.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.retrobug.launcher">
    <!-- versionCode / versionName are injected by tools/build_launcher_apk.sh (aapt2 link version flags). Declaring
         them here as well would win over those flags and pin every build to the same version. -->

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- The library's "Remove the playable copy": Android's own uninstall prompt for a converted .rb copy. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>

    <!-- The library finds installed games through the public launcher-app query; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Holo.NoActionBar"
        android:debuggable="false">
        <!-- Converted games read their per-game settings here; it answers only a copy signed with this
             device's repack key (SettingsProvider checks the caller). -->
        <provider
            android:name=".SettingsProvider"
            android:authorities="com.retrobug.launcher.settings"
            android:exported="true" />
        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
